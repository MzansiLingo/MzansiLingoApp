<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="20dp">

    <!-- Lesson title -->
    <TextView
        android:id="@+id/tvLessonTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Greetings"
        android:textSize="28sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Word counter -->
    <TextView
        android:id="@+id/tvWordCounter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Word 1 of 5"
        android:textSize="15sp"
        app:layout_constraintTop_toBottomOf="@id/tvLessonTitle"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Progress -->
    <ProgressBar
        android:id="@+id/lessonProgress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="0dp"
        android:layout_height="8dp"
        android:layout_marginTop="10dp"
        android:max="100"
        android:progress="20"
        app:layout_constraintTop_toBottomOf="@id/tvWordCounter"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Loading indicator -->
    <ProgressBar
        android:id="@+id/loadingProgress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Interactive word card -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardWord"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="28dp"
        android:layout_marginBottom="20dp"
        app:cardCornerRadius="20dp"
        app:cardElevation="6dp"
        app:layout_constraintTop_toBottomOf="@id/lessonProgress"
        app:layout_constraintBottom_toTopOf="@id/btnLearned"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="24dp">

            <!-- Xhosa word -->
            <TextView
                android:id="@+id/tvXhosaWord"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Molo"
                android:textSize="38sp"
                android:textStyle="bold"
                android:gravity="center" />

            <!-- English meaning -->
            <TextView
                android:id="@+id/tvEnglishMeaning"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Hello"
                android:textSize="20sp"
                android:gravity="center" />

            <!-- Pronunciation -->
            <Button
                android:id="@+id/btnListen"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="🔊 Listen" />

        </LinearLayout>

    </androidx.cardview.widget.CardView>

    <!-- Learned button -->
    <Button
        android:id="@+id/btnLearned"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="I've learned this"
        android:textSize="16sp"
        android:padding="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>